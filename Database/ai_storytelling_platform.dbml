Table achievements {
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  ExpTotal int [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LastStreakDate date
  StreakDays int [not null]
  UpdatedAt timestamptz
  Indexes {
    ChildProfileId [unique]
  }
}

Table knowledge_trees {
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  CurrentTreeExp int [not null]
  ExpInvested int [not null]
  FloweredTreeCount int [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LastWateredAt timestamptz
  UpdatedAt timestamptz
  Indexes {
    ChildProfileId [unique]
  }
}

Table ai_governance_metrics {
  ApprovalRate numeric(6,3)
  AvgLatencyMs int
  CreatedAt timestamptz [not null]
  GenerationSuccessRate numeric(6,3)
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  MetricDate timestamptz [not null]
  RegenerationRate numeric(6,3)
  SafetyFlagRate numeric(6,3)
  UpdatedAt timestamptz
}

Table audit_logs {
  Action varchar(150) [not null]
  ActorUserId int
  AfterState text
  BeforeState text
  CreatedAt timestamptz [not null]
  EntityId int [not null]
  EntityType varchar(150) [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  OccurredAt timestamptz [not null]
  UpdatedAt timestamptz
  Indexes {
    ActorUserId
  }
}

Table authoring_guide_catalog_versions {
  CatalogId int [not null]
  CatalogVersion varchar(50) [not null]
  ContentJson jsonb
  CreatedAt timestamptz [not null]
  CreatedByUserId int
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  PublishedAt timestamptz
  PublishedByUserId int
  Status AuthoringGuideVersionStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  UpdatedByUserId int
  VersionNo int [not null]
  Indexes {
    CatalogId [unique, note: '"Status" = \'Draft\' AND NOT "IsDeleted"']
    (CatalogId, CatalogVersion) [unique, note: 'NOT "IsDeleted"']
    (CatalogId, VersionNo) [unique, note: 'NOT "IsDeleted"']
  }
}

Table authoring_guide_catalogs {
  AudienceRole varchar(30) [not null]
  CreatedAt timestamptz [not null]
  DraftVersionId int
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Locale varchar(10) [not null]
  PublishedVersionId int
  RevisionToken varchar(64) [not null]
  UpdatedAt timestamptz
  Indexes {
    DraftVersionId
    PublishedVersionId
    (Locale, AudienceRole) [unique]
  }
}

Table authoring_guide_items {
  CatalogVersionId int [not null]
  CreatedAt timestamptz [not null]
  Example text
  GuideKey varchar(100) [not null]
  Id int [pk, not null, increment]
  Instruction text [not null]
  IsDeleted boolean [not null]
  ItemType varchar(20) [not null]
  Order int [not null]
  Purposes text[] [not null]
  SupportGroup varchar(30) [not null]
  TemplateText text
  Title text [not null]
  UpdatedAt timestamptz
  Indexes {
    (CatalogVersionId, GuideKey) [unique, note: 'NOT "IsDeleted"']
  }
}

Table authoring_guide_placeholders {
  CreatedAt timestamptz [not null]
  Hint varchar(200)
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  ItemId int [not null]
  Key varchar(50) [not null]
  Label varchar(100)
  Order int [not null]
  UpdatedAt timestamptz
  Indexes {
    (ItemId, Key) [unique, note: 'NOT "IsDeleted"']
  }
}

Table badges {
  BadgeCode varchar(100) [not null]
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  EarnedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  UpdatedAt timestamptz
  Indexes {
    (ChildProfileId, BadgeCode) [unique]
  }
}

Table business_reports {
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  PeriodEnd timestamptz [not null]
  PeriodStart timestamptz [not null]
  PublishedAt timestamptz
  ReadingSessionsCompleted int [not null]
  Status ReportStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoriesApproved int [not null]
  StoriesGenerated int [not null]
  StoriesRejected int [not null]
  UpdatedAt timestamptz
}

Table child_access_credentials {
  AvatarId varchar(100) [not null]
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  CreatedByUserId int [not null]
  EasyLoginCreatedAt timestamptz
  EasyLoginSecretHash varchar(64)
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  RevokedAt timestamptz
  UpdatedAt timestamptz
  Indexes {
    ChildProfileId [unique, note: '"RevokedAt" IS NULL AND "IsDeleted" = false']
    CreatedByUserId
    EasyLoginSecretHash [unique, note: '"EasyLoginSecretHash" IS NOT NULL']
  }
}

Table child_profile_version_history {
  AppliedAt timestamptz [not null]
  AppliedByUserId int
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  NewConfig text [not null]
  PreviousConfig text [not null]
  Source VersionHistorySource [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  VersionStatus VersionHistoryStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  Indexes {
    AppliedByUserId
    ChildProfileId
  }
}

Table child_profiles {
  AgeBand AgeBand [not null, note: 'EF PostgreSQL type: character varying(30)']
  AvatarId varchar(100) [not null]
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Language varchar(10) [not null]
  Nickname varchar(150) [not null]
  OwnerUserId int [not null]
  Status ChildProfileStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  Indexes {
    OwnerUserId
  }
}

Table child_roadmap_items {
  AddedByUserId int [not null]
  ChildProfileId int [not null]
  CompletedAt timestamptz
  CreatedAt timestamptz [not null]
  ExpectedCompletionAt timestamptz
  ExpectedDays int
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Note varchar(500)
  OpenedAt timestamptz
  Position int [not null]
  RemovedAt timestamptz
  RemovedByUserId int
  SkipReason ChildRoadmapSkipReason [note: 'EF PostgreSQL type: character varying(30)']
  SkippedAt timestamptz
  Source ChildRoadmapItemSource [not null, note: 'EF PostgreSQL type: character varying(30)']
  SourceReadingRoadmapId int
  Status ChildRoadmapItemStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int [not null]
  UpdatedAt timestamptz
  Indexes {
    AddedByUserId
    ChildProfileId [unique, note: '"Status" = \'Open\' AND NOT "IsDeleted"']
    RemovedByUserId
    SourceReadingRoadmapId
    StoryId
    (ChildProfileId, StoryId) [unique, note: '"Status" IN (\'Waiting\', \'Open\') AND NOT "IsDeleted"']
    (ChildProfileId, Status, Position)
  }
}

Table child_sessions {
  ChildAccessCredentialId int
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  EntryMethod ChildEntryMethod [not null, note: 'EF PostgreSQL type: character varying(30)']
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LastActivityAt timestamptz [not null]
  SessionKey varchar(64) [not null]
  SupervisorSessionId int
  UpdatedAt timestamptz
  Indexes {
    ChildAccessCredentialId
    ChildProfileId
    SessionKey [unique]
    SupervisorSessionId
  }
  Note: 'CHECK constraints: CK_child_sessions_exactly_one_entry_source: ("ChildAccessCredentialId" IS NOT NULL AND "SupervisorSessionId" IS NULL) OR ("ChildAccessCredentialId" IS NULL AND "SupervisorSessionId" IS NOT NULL)'
}

Table content_categories {
  Code varchar(100) [not null]
  CreatedAt timestamptz [not null]
  CreatedByAdminId int
  DefaultBlockedAgeBands text[] [not null]
  DisplayName varchar(150) [not null]
  Id int [pk, not null, increment]
  IsActive boolean [not null]
  IsDeleted boolean [not null]
  UpdatedAt timestamptz
  Indexes {
    Code [unique]
    CreatedByAdminId
  }
}

Table content_reports {
  AttachmentUrl varchar(500)
  CreatedAt timestamptz [not null]
  Description text
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  IsReviewItem boolean [not null]
  ReadingRoadmapId int
  Reason ContentReportReason [not null, note: 'EF PostgreSQL type: character varying(30)']
  ReporterUserId int [not null]
  ResolvedAt timestamptz
  ReviewedAt timestamptz
  ReviewedByUserId int
  Status ContentReportStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int [not null]
  StoryVersionId int
  UpdatedAt timestamptz
  Indexes {
    ReadingRoadmapId
    ReporterUserId
    ReviewedByUserId
    StoryId
    StoryVersionId
  }
}

Table illustration_beats {
  BeatOrder int [not null]
  CreatedAt timestamptz [not null]
  EndOffset int [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  StartOffset int [not null]
  StorySceneId int [not null]
  UpdatedAt timestamptz
  VisualFocus varchar(500) [not null]
  Indexes {
    (StorySceneId, BeatOrder) [unique]
  }
  Note: 'CHECK constraints: CK_illustration_beats_offsets: "StartOffset" >= 0 AND "EndOffset" > "StartOffset"; CK_illustration_beats_order: "BeatOrder" BETWEEN 1 AND 3'
}

Table learning_artifact_generation_batches {
  AttemptCount int [not null]
  BatchNumber int [not null]
  CompletedAt timestamptz
  ConcurrencyToken varchar(32) [not null]
  ContextFingerprint varchar(64) [not null]
  CreatedAt timestamptz [not null]
  ErrorCode varchar(100)
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Kind varchar(40) [not null]
  LeaseExpiresAt timestamptz
  NextAttemptAt timestamptz
  RequestJson jsonb [not null]
  RequestedByUserId int [not null]
  ResultJson jsonb
  RootClaimToken varchar(32)
  RootJobId int [not null]
  ShortfallReason varchar(300)
  SourceFingerprint varchar(64) [not null]
  Status GenerationJobStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int [not null]
  StoryVersionId int [not null]
  TargetCount int [not null]
  UpdatedAt timestamptz
  Indexes {
    RequestedByUserId
    StoryVersionId
    (RootJobId, Kind, BatchNumber) [unique]
    (StoryId, Status, LeaseExpiresAt)
  }
}

Table learning_profile_topics {
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LearningProfileId int [not null]
  Relation TopicRelation [not null, note: 'EF PostgreSQL type: character varying(30)']
  Topic varchar(150) [not null]
  UpdatedAt timestamptz
  Indexes {
    LearningProfileId
  }
}

Table learning_profiles {
  ChildProfileId int [not null]
  ComprehensionGoal varchar(500)
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  ReadingLevel int [not null]
  ReadingMode ReadingMode [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  Indexes {
    ChildProfileId [unique]
  }
}

Table listening_interaction_attempts {
  AnswerText varchar(200)
  AttemptedAt timestamptz [not null]
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  IsMatch boolean
  ListeningInteractionId int [not null]
  OrderedOptionIdsJson varchar(200)
  ReadingSessionId int [not null]
  SelectedOptionId int
  UpdatedAt timestamptz
  Indexes {
    ChildProfileId
    ListeningInteractionId
    SelectedOptionId
    (ReadingSessionId, ListeningInteractionId)
  }
}

Table listening_interaction_options {
  CorrectOrder int
  CreatedAt timestamptz [not null]
  Feedback text
  Id int [pk, not null, increment]
  ImageDescription text
  IsDeleted boolean [not null]
  IsMatch boolean [not null]
  ListeningInteractionId int [not null]
  SortOrder int [not null]
  SourceEnd int
  SourceQuote text
  SourceStart int
  Text text [not null]
  UpdatedAt timestamptz
  Indexes {
    (ListeningInteractionId, SortOrder) [unique, note: '"IsDeleted" = false']
  }
}

Table listening_interactions {
  AnchorOffset int [not null]
  CharacterName varchar(100)
  CreatedAt timestamptz [not null]
  Explanation text
  HiddenWord varchar(100)
  Hint text
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Kind CheckpointKind [note: 'EF PostgreSQL type: character varying(30)']
  MatchFeedback text
  NoMatchFeedback text
  Prompt text
  RevealOffset int
  SourceEnd int
  SourceQuote text
  SourceStart int
  StorySceneId int
  StoryVersionId int [not null]
  Type ListeningInteractionType [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  WaitFeedback text
  Indexes {
    StorySceneId
    (StoryVersionId, AnchorOffset) [unique, note: '"IsDeleted" = false']
    (StoryVersionId, Type)
  }
}

Table media_asset_generation_tasks {
  AttemptNo int [not null]
  BranchJobId int [not null]
  CompletedAt timestamptz
  ConcurrencyToken varchar(32) [not null]
  CreatedAt timestamptz [not null]
  ErrorCode varchar(100)
  Id int [pk, not null, increment]
  IllustrationBeatId int [not null]
  IsDeleted boolean [not null]
  LeaseExpiresAt timestamptz
  MediaAssetId int [not null]
  MediaContextId int [not null]
  NextAttemptAt timestamptz
  PackageRevision int [not null]
  QueuedAt timestamptz [not null]
  StartedAt timestamptz
  Status GenerationJobStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int [not null]
  StoryVersionId int [not null]
  UpdatedAt timestamptz
  Indexes {
    IllustrationBeatId
    MediaAssetId [unique]
    MediaContextId
    StoryVersionId
    (Status, NextAttemptAt, QueuedAt)
    (StoryId, Status, LeaseExpiresAt)
    (BranchJobId, PackageRevision, Status, NextAttemptAt)
  }
}

Table media_assets {
  AttemptCount int [not null]
  AudioPartKey varchar(30)
  CompletedAt timestamptz
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IllustrationBeatId int
  IsCurrent boolean [not null]
  IsDeleted boolean [not null]
  LastValidationReason varchar(500)
  ListeningInteractionId int
  ListeningInteractionOptionId int
  MimeType varchar(100)
  Model varchar(120)
  Provider varchar(50)
  ProviderAssetId varchar(200)
  ProviderRequestId varchar(120)
  ReferenceImageAssetId int
  ReplacementResolvedAt timestamptz
  ReplacesMediaAssetId int
  RequestedPackageRevision int
  SceneIndex int
  Status MediaStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StorySceneId int
  StorySegmentId int
  StoryVersionId int [not null]
  StoryVocabularyId int
  Type MediaType [not null, note: 'EF PostgreSQL type: character varying(30)']
  UpdatedAt timestamptz
  Url varchar(500)
  ValidationResultJson text
  ValidationStatus ValidationStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  WordTimings text
  Indexes {
    ListeningInteractionId [note: '"ListeningInteractionId" IS NOT NULL']
    ListeningInteractionOptionId
    ReplacesMediaAssetId [unique, note: '"ReplacesMediaAssetId" IS NOT NULL AND "ReplacementResolvedAt" IS NULL AND "IsDeleted" = false']
    StorySceneId
    (IllustrationBeatId, Type) [unique, note: '"IllustrationBeatId" IS NOT NULL AND "IsDeleted" = false AND "IsCurrent" = true']
    (StorySegmentId, Type) [unique, note: '"StorySegmentId" IS NOT NULL AND "IsDeleted" = false AND "IsCurrent" = true']
    (StoryVersionId, RequestedPackageRevision)
    (StoryVocabularyId, Type) [unique, note: '"StoryVocabularyId" IS NOT NULL AND "IsDeleted" = false AND "IsCurrent" = true']
  }
  Note: 'CHECK constraints: CK_media_assets_attempt_count: "AttemptCount" >= 0; CK_media_assets_beat_must_be_null_for_audio: "Type" <> \'TtsAudio\' OR "IllustrationBeatId" IS NULL; CK_media_assets_beat_required_for_illustration: "Type" <> \'Illustration\' OR "StorySceneId" IS NULL OR "IllustrationBeatId" IS NOT NULL; CK_media_assets_interaction_required_for_listening_audio: "Type" <> \'ListeningAudio\' OR "ListeningInteractionId" IS NOT NULL; CK_media_assets_option_required_for_listening_image: "Type" <> \'ListeningImage\' OR "ListeningInteractionOptionId" IS NOT NULL; CK_media_assets_segment_must_be_null_for_illustration: "Type" <> \'Illustration\' OR "StorySegmentId" IS NULL; CK_media_assets_segment_required_for_audio: "Type" <> \'TtsAudio\' OR "StorySegmentId" IS NOT NULL; CK_media_assets_vocabulary_required_for_vocabulary_audio: "Type" <> \'VocabularyAudio\' OR "StoryVocabularyId" IS NOT NULL'
}


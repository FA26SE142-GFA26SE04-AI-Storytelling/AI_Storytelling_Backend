# Copy this file to .env and replace every change-me value before starting Compose.
POSTGRES_DB=AIStorytellingDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_PORT=5433

CORE_API_PORT=5259
AI_API_PORT=5260
SWAGGER_ENABLED=true

# Must contain at least 32 characters.
JWT_SECRET_KEY=change-me-with-at-least-32-characters
JWT_ISSUER=StoryPlatform
JWT_AUDIENCE=StoryPlatform.Client
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_CHILD_TOKEN_EXPIRY_MINUTES=240

# Internal credential required by AI API in Production.
AI_INTERNAL_API_KEY=change-me-internal-service-key
AI_PROVIDER=Gemini
# Compose connects Core to ai-api:8080 and passes the same internal key to both.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# --- Google Vertex AI (recommended for production) ---
# Set VERTEX_AI_ENABLED=true to use Vertex AI instead of the public Gemini API key.
# Requires a Google Cloud service account with roles/aiplatform.user.
# Mount the key file into the container (see compose.yaml volumes), then set VERTEX_CREDENTIALS_PATH.
# The same service-account key can be shared between Vertex AI calls and Google Cloud TTS.
VERTEX_AI_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# Path inside the container where the service-account JSON key is mounted.
# Example (see compose.yaml): /app/secrets/vertex-sa-key.json
VERTEX_CREDENTIALS_PATH=

# Local user ADC: add -f compose.adc.yaml. Each developer supplies their own file.
# Windows: C:/Users/YOUR_USER/AppData/Roaming/gcloud/application_default_credentials.json
# Linux: /home/YOUR_USER/.config/gcloud/application_default_credentials.json
# macOS: /Users/YOUR_USER/.config/gcloud/application_default_credentials.json
GOOGLE_ADC_FILE=
# Use the text model already verified for the team's Google Cloud project/location.
VERTEX_TEXT_MODEL=
# Linux: set these to `id -u` / `id -g` so non-root containers can read your ADC file.
LOCAL_UID=1654
LOCAL_GID=1654
# Local test thresholds only; not an approved production moderation policy.
GRAY_ZONE_WARNING_THRESHOLD=50
GRAY_ZONE_BLOCK_THRESHOLD=100

# Database migration is an explicit command via db-migrate (tools profile).
# Set true only for an intentional first-run demo seed, then return it to false.
SEED_DATA_RUN_ON_STARTUP=false

# Keep disabled until Gemini media providers and storage are configured.
MEDIA_WORKER_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=story-media

# Optional integrations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=AI Storytelling Platform
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# Copy this file to .env and replace every change-me value before starting Compose.
POSTGRES_DB=AIStorytellingDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_PORT=5433

CORE_API_PORT=5259
AI_API_PORT=5260
SWAGGER_ENABLED=true

# Must contain at least 32 characters.
JWT_SECRET_KEY=change-me-with-at-least-32-characters
JWT_ISSUER=StoryPlatform
JWT_AUDIENCE=StoryPlatform.Client
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_CHILD_TOKEN_EXPIRY_MINUTES=120

# Internal credential required by AI API in Production.
AI_INTERNAL_API_KEY=change-me-internal-service-key
AI_PROVIDER=Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# Keep disabled until Gemini media providers and storage are configured.
MEDIA_WORKER_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=story-media

# Optional integrations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=AI Storytelling Platform
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

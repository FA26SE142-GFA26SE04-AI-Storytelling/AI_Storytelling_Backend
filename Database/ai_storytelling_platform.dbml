Table story_generation_jobs {
  AttemptNo int [not null]
  BaseStoryVersionId int
  CompletedAt timestamptz
  ConcurrencyToken varchar(32) [not null]
  CreatedAt timestamptz [not null]
  ErrorCode varchar(100)
  FallbackMessage text
  GenerationMetadataJson jsonb
  GenerationRequestId int
  GuardrailResult GuardrailResult [note: 'EF PostgreSQL type: character varying(30)']
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LeaseExpiresAt timestamptz
  ListeningInteractionType ListeningInteractionType [note: 'EF PostgreSQL type: character varying(30)']
  MaxAttempts int [not null]
  MediaContextId int
  MediaPackageRevision int
  NextAttemptAt timestamptz
  Operation GenerationJobOperation [not null, note: 'EF PostgreSQL type: character varying(30)']
  OperationKey varchar(100)
  ParentJobId int
  PromptCatalogVersionId int
  RequestedByUserId int
  Stage JobStage [not null, note: 'EF PostgreSQL type: character varying(30)']
  StartedAt timestamptz [not null]
  Status GenerationJobStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int [not null]
  StoryVersionId int
  UpdatedAt timestamptz
  Indexes {
    BaseStoryVersionId
    GenerationRequestId
    MediaContextId
    PromptCatalogVersionId
    StoryId [unique, note: '"Operation" IN (\'GenerateOutline\', \'RegenerateOutline\') AND "Status" IN (\'Pending\', \'Processing\') AND "IsDeleted" = false']
    StoryVersionId
    (Operation, StoryVersionId) [unique, note: '"StoryVersionId" IS NOT NULL AND "IsDeleted" = false AND "Operation" <> \'GenerateListeningInteraction\'']
    (StoryVersionId, ListeningInteractionType) [unique, note: '"Operation" = \'GenerateListeningInteraction\' AND "StoryVersionId" IS NOT NULL AND "IsDeleted" = false']
    (ParentJobId, Status, NextAttemptAt)
    (RequestedByUserId, Operation, OperationKey) [unique, note: '"RequestedByUserId" IS NOT NULL AND "OperationKey" IS NOT NULL AND "IsDeleted" = false']
    (Status, Stage, LeaseExpiresAt)
  }
}


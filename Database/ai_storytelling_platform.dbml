Project ai_storytelling_platform {
  database_type: 'PostgreSQL'
  Note: 'ERD derived from the current EF Core model. Column names follow PostgreSQL mappings; enum columns use Domain enum names for the diagram; their EF PostgreSQL storage types are noted on each column. Database defaults are omitted; this file does not assert that migrations were applied to a live database.'
}

// Enum values are taken from StoryPlatform.Domain.Enums.
// The EF mapping stores these columns as the physical type shown in each column note.


  ReviewStatus VersionReviewStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  ReviewSubmittedAt timestamptz
  ReviewedAt timestamptz
  ReviewedByUserId int
  StoryVersionId int [pk, not null]
  Indexes {
    GrayZoneClearedByUserId
    ReviewedByUserId
  }
}

Table story_versions {
  AudienceRevision int [not null]
  BaseVersionId int
  Content text
  CreatedAt timestamptz [not null]
  EditType VersionEditType [not null, note: 'EF PostgreSQL type: character varying(30)']
  EditorUserId int
  Id int [pk, not null, increment]
  IsCurrent boolean [not null]
  IsDeleted boolean [not null]
  Lesson text
  OutlineApprovedAt timestamptz
  OutlineApprovedByUserId int
  OutlineDevelopment text
  OutlineEnding text
  OutlineOpening text
  ReadabilityFkgl numeric(6,3)
  ReadabilityFre numeric(6,3)
  RestoredFromVersionId int
  SafetyScore numeric(6,3)
  StoryId int [not null]
  Title varchar(200) [not null]
  UpdatedAt timestamptz
  VersionNo int [not null]
  Indexes {
    (Id, StoryId) [unique]
    BaseVersionId
    EditorUserId
    OutlineApprovedByUserId
    RestoredFromVersionId
    StoryId [unique, note: '"IsCurrent" = true AND "IsDeleted" = false']
    (StoryId, VersionNo) [unique]
  }
}

Table story_vocabulary {
  CreatedAt timestamptz [not null]
  Definition text [not null]
  Example text
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  SourceEnd int
  SourceQuote text
  SourceStart int
  StoryVersionId int [not null]
  Term varchar(150) [not null]
  UpdatedAt timestamptz
  Indexes {
    StoryVersionId
  }
}

Table story_wish_card_matches {
  CreatedAt timestamptz [not null]
  CreatedByUserId int
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Source WishCardMatchSource [not null, note: 'EF PostgreSQL type: character varying(20)']
  StoryId int [not null]
  UpdatedAt timestamptz
  WishCardId int [not null]
  Indexes {
    WishCardId
    (StoryId, WishCardId) [unique]
  }
}

Table story_wish_suggestions {
  CommunitySubmissionId int
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  MatchedCardIds varchar(100) [not null]
  Rank int [not null]
  Score int [not null]
  StoryId int [not null]
  StoryWishId int [not null]
  UpdatedAt timestamptz
  Indexes {
    StoryId
    (StoryWishId, Rank) [unique]
    (StoryWishId, StoryId) [unique]
  }
}

Table story_wishes {
  ChallengeCardId int
  CharacterCardId int
  ChildProfileId int [not null]
  CreatedAt timestamptz [not null]
  DeclineReason varchar(500)
  ExpiryWarnedAt timestamptz
  FulfilledStoryId int
  FulfilledWithExistingStory boolean [not null]
  GeneratedStoryId int
  GenerationRequestId int
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  Kind StoryWishKind [not null, note: 'EF PostgreSQL type: character varying(20)']
  LessonCardId int
  LessonLeftToParent boolean [not null]
  PendingSince timestamptz
  PlaceCardId int
  ResolutionNote varchar(50)
  ResolvedAt timestamptz
  ResolvedByUserId int
  Status StoryWishStatus [not null, note: 'EF PostgreSQL type: character varying(20)']
  SubmittedAt timestamptz
  UpdatedAt timestamptz
  Indexes {
    ChallengeCardId
    CharacterCardId
    ChildProfileId [unique, note: '"Status" = \'Draft\' AND "IsDeleted" = false']
    FulfilledStoryId
    GeneratedStoryId
    LessonCardId
    PlaceCardId
    (Status, PendingSince)
    (ChildProfileId, Status, SubmittedAt)
  }
}

Table subscription_plans {
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsActive boolean [not null]
  IsDeleted boolean [not null]
  Name varchar(150) [not null]
  PriceVnd int [not null]
  QuotaAmount int [not null]
  UpdatedAt timestamptz
}

Table telemetry_logs {
  CreatedAt timestamptz [not null]
  EventPayload text
  EventType TelemetryEventType [not null, note: 'EF PostgreSQL type: character varying(40)']
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  OccurredAt timestamptz [not null]
  ReadingSessionId int [not null]
  UpdatedAt timestamptz
  Indexes {
    ReadingSessionId
  }
}

Table token_quota_configs {
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  PeriodEnd date [not null]
  PeriodStart date [not null]
  QuotaLimit int [not null]
  QuotaUsed int [not null]
  Scope TokenQuotaScope [not null, note: 'EF PostgreSQL type: character varying(20)']
  UpdatedAt timestamptz
  UserId int
  Indexes {
    UserId
  }
}

Table user_accounts {
  AvatarUrl varchar(500)
  CommitmentAcceptedAt timestamptz
  CreatedAt timestamptz [not null]
  Email varchar(150) [not null]
  EmailVerificationFailedAttempts int [not null]
  EmailVerificationTokenExpiresAt timestamptz
  EmailVerificationTokenHash varchar(64)
  EmailVerifiedAt timestamptz
  Expertise varchar(200)
  FailedLoginAttempts int [not null]
  FullName varchar(100) [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  LastLoginAt timestamptz
  LockedUntil timestamptz
  PasswordChangedAt timestamptz
  PasswordHash varchar(255) [not null]
  PendingEmail varchar(150)
  PendingEmailOtpExpiresAt timestamptz
  PendingEmailOtpFailedAttempts int [not null]
  PendingEmailOtpHash varchar(64)
  PhoneNumber varchar(20)
  RefreshTokenExpiresAt timestamptz
  RefreshTokenHash varchar(64)
  ResetTokenExpiresAt timestamptz
  ResetTokenHash varchar(255)
  Role UserRole [not null, note: 'EF PostgreSQL type: character varying(30)']
  RoleBeforeAdmin UserRole [note: 'EF PostgreSQL type: character varying(30)']
  Status AccountStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  TokenVersion int [not null]
  UpdatedAt timestamptz
  Username varchar(50) [not null]
  Indexes {
    Email [unique]
    Username [unique]
  }
}

Table vocabulary_notebook_entries {
  ChildProfileId int [not null]
  CollectedAt timestamptz [not null]
  CreatedAt timestamptz [not null]
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  RemovedAt timestamptz
  StoryVocabularyId int [not null]
  UpdatedAt timestamptz
  Indexes {
    StoryVocabularyId
    (ChildProfileId, StoryVocabularyId) [unique]
  }
}

Table wish_cards {
  AgeBand AgeBand [note: 'EF PostgreSQL type: character varying(30)']
  AudioUrl varchar(500)
  ContentCategoryId int
  CreatedAt timestamptz [not null]
  CreatedByUserId int
  Group WishCardGroup [not null, note: 'EF PostgreSQL type: character varying(30)']
  Id int [pk, not null, increment]
  ImageUrl varchar(500) [not null]
  IsActive boolean [not null]
  IsDeleted boolean [not null]
  Label varchar(100) [not null]
  SortOrder int [not null]
  UpdatedAt timestamptz
  Indexes {
    ContentCategoryId
    (Group, IsActive, SortOrder)
  }
}


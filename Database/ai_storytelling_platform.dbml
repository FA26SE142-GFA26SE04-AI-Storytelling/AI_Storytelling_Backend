Table moderation_items {
  Checklist jsonb
  ClaimedAt timestamptz
  ClaimedByUserId int
  ClosedReason varchar(50)
  ContentReportId int
  CopyrightDeclaration CopyrightDeclaration [note: 'EF PostgreSQL type: character varying(30)']
  CreatedAt timestamptz [not null]
  CreatedByUserId int
  DecidedAt timestamptz
  DecidedByUserId int
  DecisionReason text
  EscalatedAt timestamptz
  EscalationReason varchar(1000)
  Feedback jsonb
  Flags jsonb
  Id int [pk, not null, increment]
  IsDeleted boolean [not null]
  IsResubmission boolean [not null]
  ItemType ModerationItemType [not null, note: 'EF PostgreSQL type: character varying(30)']
  PiiCheckResult jsonb
  PreviousItemId int
  Priority ModerationPriority [not null, note: 'EF PostgreSQL type: character varying(30)']
  ReadingRoadmapId int
  RemovedAt timestamptz
  ReviewProgress jsonb
  RowVersion int [not null]
  SlaDueAt timestamptz
  SlaWarnedAt timestamptz
  SourceChildProfileId int
  Status ModerationItemStatus [not null, note: 'EF PostgreSQL type: character varying(30)']
  StoryId int
  StoryVersionId int
  UpdatedAt timestamptz
  WithdrawnAt timestamptz
  Indexes {
    ContentReportId
    CreatedByUserId
    DecidedByUserId
    PreviousItemId
    ReadingRoadmapId [unique, note: '"ItemType" = \'RoadmapTemplateReview\' AND "Status" IN (\'Pending\', \'Claimed\') AND NOT "IsDeleted"']
    SourceChildProfileId
    StoryId [unique, note: '"ItemType" = \'CommunitySubmission\' AND "Status" IN (\'Pending\', \'Approved\') AND NOT "IsDeleted"']
    StoryVersionId
    (ClaimedByUserId, Status)
    (ItemType, Status, Priority)
  }
  Note: 'CHECK constraints: ck_moderation_items_claimer_is_not_creator: "ClaimedByUserId" IS NULL OR "CreatedByUserId" IS NULL OR "ClaimedByUserId" <> "CreatedByUserId"'
}

